APP_NAME="Lindu CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
DB_CONNECTION=sqlite
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=lindu
#DB_USERNAME=root
#DB_PASSWORD=
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
MAIL_MAILER=log
MEDIA_DISK=public
MEDIA_CDN_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
LINDU_NAME="Lindu CMS"
LINDU_TENANT_MODE=multi
SEARCH_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# License v3 pairing (marketplace kit)
LICENSE_SERVER_URL=https://whitelabel.co.id
# Enforce the pairing gate. Leave ON for any real deployment.
LICENSE_ENFORCE=true
# Skip the license check on localhost/.test hosts. Keep this FALSE outside
# local development — the `local` and `testing` environments already bypass
# automatically, so turning this on in production only weakens protection.
LICENSE_DEV_BYPASS=false
LICENSE_HEARTBEAT_INTERVAL=86400
LICENSE_HEARTBEAT_GRACE=604800
# Optional remote verification provider implementing
# App\Core\Contracts\LicenseProvider. Empty = local license rows only.
LINDU_LICENSE_PROVIDER=

# Subdomain tenancy. Leave empty unless you host tenants as subdomains;
# with it empty only an exact `domain` match on the tenant row is used.
LINDU_TENANT_BASE_DOMAIN=
